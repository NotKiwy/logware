{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(sec) {
	tls /tls/origin.pem /tls/origin.key
	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
	}
}

(txt) {
	handle /.well-known/security.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `Contact: https://t.me/logware_support_bot
Expires: 2027-12-31T23:59:59.000Z
Preferred-Languages: ru, en
Policy: https://docs.logware.dev/legal/terms
` 200
	}
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `User-agent: *
Disallow: /
` 200
	}
}

(proxy) {
	header_up X-Forwarded-For {client_ip}
	header_down -Via
	header_down -Server
}

(noframe) {
	header Content-Security-Policy "frame-ancestors 'none'"
	header X-Frame-Options "DENY"
}

{$APP} {
	import sec
	import txt
	header Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
	encode zstd gzip
	reverse_proxy prod-bot:8080 {
		import proxy
	}
}

{$DEV} {
	import sec
	import txt
	header Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
	encode zstd gzip
	reverse_proxy test-bot:8080 {
		import proxy
	}
}

{$PAY} {
	import sec
	import txt
	import noframe
	@hook {
		method POST
		path /hook /hook/* /cb /xr /
	}
	handle @hook {
		rewrite /cb /hook/cb
		rewrite /xr /hook/xr
		rewrite / /hook
		reverse_proxy prod-bot:8080 {
			import proxy
		}
	}
	handle {
		respond 404
	}
}
